{
  "name": "xsess",
  "version": "0.0.6",
  "description": "Framework-agnostic session middleware with cookie and header support",
  "author": {
    "name": "hexac",
    "url": "https://existin.space",
    "email": "hexac@existin.space"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eishexac/xsess.git"
  },
  "homepage": "https://github.com/eishexac/xsess#readme",
  "bugs": "https://github.com/eishexac/xsess/issues",
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/middleware/express/express.d.ts",
      "import": "./dist/middleware/express/express.js"
    },
    "./hono": {
      "types": "./dist/middleware/hono/hono.d.ts",
      "import": "./dist/middleware/hono/hono.js"
    },
    "./socket.io": {
      "types": "./dist/middleware/socketio/socketio.d.ts",
      "import": "./dist/middleware/socketio/socketio.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "type:check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint",
      "prettier --check"
    ]
  },
  "dependencies": {
    "cookie": "^1.1.1",
    "cookie-signature": "^1.2.2",
    "on-headers": "^1.1.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/cookie-signature": "^1.1.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.1.0",
    "@types/on-headers": "^1.0.4",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.1.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.1.0",
    "globals": "^16.5.0",
    "hono": "^4.12.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "socket.io": "^4.8.3",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0",
    "hono": "^4.0.0",
    "socket.io": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "socket.io": {
      "optional": true
    }
  }
}
